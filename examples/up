#!/usr/bin/env bash
# Local example: install a browser-trusted CA, write examples/certs, start Compose.
# CI does not use this script. It generates a self-signed cert in setup-docker-compose.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<'EOF'
Usage: ./examples/up [--ebpf] [--no-open]

  Installs a local CA with mkcert (one system prompt), writes
  examples/certs/server.crt and server.key, and starts the example stack.
  Then opens https://localhost.

  --ebpf     Also start the eBPF agent (examples/docker-compose.release-ebpf.yml).
             On macOS the agent runs inside Docker Desktop's Linux VM and
             attaches the XDP hook there. The native macOS binary has no eBPF.
             Without this flag, start examples/docker-compose.release-without-ebpf.yml.
  --no-open  Do not open a browser.
EOF
}

ebpf=0
open_browser=1
for arg in "$@"; do
  case "$arg" in
    --ebpf) ebpf=1 ;;
    --no-open) open_browser=0 ;;
    -h | --help) usage; exit 0 ;;
    *)
      echo "unknown argument: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

os=$(uname -s)
case "$os" in
  Linux | Darwin) ;;
  *)
    echo "examples/up supports Linux and macOS. This host reports $os." >&2
    exit 1
    ;;
esac

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker and run ./examples/up again." >&2
  exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose v2 is required (the \`docker compose\` command)." >&2
  exit 1
fi

if ! command -v mkcert >/dev/null 2>&1; then
  echo "mkcert is not installed. Install it, then run ./examples/up again." >&2
  case "$os" in
    Darwin)
      echo "  brew install mkcert nss" >&2
      ;;
    Linux)
      if command -v apt-get >/dev/null 2>&1; then
        echo "  sudo apt install mkcert libnss3-tools" >&2
      elif command -v dnf >/dev/null 2>&1; then
        echo "  sudo dnf install mkcert nss-tools" >&2
      elif command -v pacman >/dev/null 2>&1; then
        echo "  sudo pacman -S mkcert nss" >&2
      else
        echo "  install mkcert and the NSS tools from your package manager" >&2
        echo "  https://github.com/FiloSottile/mkcert#installation" >&2
      fi
      ;;
  esac
  exit 1
fi

echo "Installing the local CA. The system will ask you to authorize it."
mkcert -install

mkdir -p examples/certs
if [[ ! -w examples/certs ]]; then
  sudo chown "$USER" examples/certs
fi
# A previous run leaves server.key owned by UID 10001 with mode 0600. mkcert cannot
# overwrite it, but removing it only needs write access to the directory.
rm -f examples/certs/server.key examples/certs/server.crt
mkcert \
  -key-file examples/certs/server.key \
  -cert-file examples/certs/server.crt \
  localhost 127.0.0.1 ::1

chmod 644 examples/certs/server.crt
if [[ "$os" == "Linux" ]]; then
  chmod 600 examples/certs/server.key
  if ! chown 10001 examples/certs/server.key 2>/dev/null; then
    sudo chown 10001 examples/certs/server.key
  fi
else
  # Docker Desktop on macOS does not map host UID 10001 into the container.
  # The proxy can read the key and logs that the example key is world-readable.
  chmod 644 examples/certs/server.key
fi

if [[ "$ebpf" -eq 1 ]]; then
  compose_file=examples/docker-compose.release-ebpf.yml
  services=(proxy ebpf-agent)
else
  compose_file=examples/docker-compose.release-without-ebpf.yml
  services=(proxy)
fi

echo "Starting ${compose_file}"
docker compose -f "$compose_file" pull
docker compose -f "$compose_file" up -d

deadline=$((SECONDS + 180))
ready=0
until [[ "$SECONDS" -ge "$deadline" ]]; do
  ready=1
  for svc in "${services[@]}"; do
    if ! docker compose -f "$compose_file" ps "$svc" | grep -q "(healthy)"; then
      ready=0
    fi
  done
  if [[ "$ready" -eq 1 ]]; then
    break
  fi
  sleep 2
done
if [[ "$ready" -ne 1 ]]; then
  echo "Services did not become healthy in time." >&2
  docker compose -f "$compose_file" ps >&2
  exit 1
fi

url=https://localhost
echo "Ready: $url"
echo "Logs:  docker compose -f $compose_file logs -f proxy"
echo "Stop:  docker compose -f $compose_file down"

if [[ "$open_browser" -eq 1 ]]; then
  case "$os" in
    Darwin) open "$url" >/dev/null 2>&1 || true ;;
    Linux) xdg-open "$url" >/dev/null 2>&1 || true ;;
  esac
fi
